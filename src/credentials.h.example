#pragma once

// Copy this file to credentials.h and fill in your values.
// credentials.h is gitignored so your secrets stay local.

// --- WiFi ---
#define WIFI_SSID       "YourWiFiNetwork"
#define WIFI_PASS       "YourWiFiPassword"

// --- MQTT ---
#define MQTT_HOST       "192.168.1.100"   // IP of your HA / MQTT broker
#define MQTT_PORT       1883
#define MQTT_USER       "mqtt"
#define MQTT_PASS       "mqtt_password"

// --- Gate BLE ---
// Find the MAC in the Ditec app → Info screen (looks like 00:60:37:XX:XX:XX)
// Works with both ION4 and ION6 gates (RCB100 BLE module).
#define GATE_BLE_ADDR   "00:60:37:XX:XX:XX"
// 6-digit PIN you set in the Ditec app (as a plain integer, no quotes)
#define GATE_PIN        123456
